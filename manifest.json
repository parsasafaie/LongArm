{
  "manifest_version": 3,
  "name": "LongArm",
  "version": "0.0.1",
  "description": "Connects ChatGPT, Gemini, Claude and web LLMs with local MCP servers over WebSocket.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "LongArm",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "ws://localhost/*",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content_scripts/constants.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/hide.js",
        "content_scripts/ui_widget.js",
        "content_scripts/call_registry.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/chatgpt.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_scripts/constants.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/hide.js",
        "content_scripts/ui_widget.js",
        "content_scripts/call_registry.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/gemini.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content_scripts/constants.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/hide.js",
        "content_scripts/ui_widget.js",
        "content_scripts/call_registry.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/claude.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content_scripts/constants.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/hide.js",
        "content_scripts/ui_widget.js",
        "content_scripts/call_registry.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/deepseek.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
